#adding fixed numbers to each term:
#formula => an=a+(n-1)d
print("adding fixed numbers")
first=int(input("ENTER YOUR FIRST NUMBER:"))
defferance=int(input("ENTER YOUR defferance NUMBER:"))
n=int(input("ENTER YOUR last NUMBER:"))
def atomatic_number(first,defferance,n):
    sequence = []
    for i in range(n):                       #i works as n-1 because its index starts from "0"
        sequence.append(first +i*defferance) # i not = n , it is for loop that starts from first number ends at last number
    return sequence
print(atomatic_number(first,defferance,n))

